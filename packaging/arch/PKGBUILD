pkgname=araneola
pkgver=0.0.2
pkgrel=1
pkgdesc="Web crawler and sitemap generator written in Guile Scheme"
arch=('any')
url="https://codeberg.org/jjba23/araneola"
license=('AGPL-3.0-or-later')

depends=(
  'guile'
  'bash'
  'coreutils'
  'guile-lib'
  'scriba'
)

makedepends=(
  'guile'
  'pkgconf'
)

source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('337b56e5bb31a0715b48cd3f9a263d2b5f4104746c179f0f93b04f9fcacd272a')

# scriba is produced by the same packaging batch; build it first.

# Upstream reads resources and the log helper from the generic
# share/resources and share/scripts; several of these packages
# would clash there, so both move under share/araneola/.

# Guile looks for byte-compiled modules under the site-ccache directory,
# which differs between distributions, so ask Guile's pkg-config file
# instead of hard-coding a path.
_site_dir() {
  pkg-config --variable=sitedir guile-3.0 2>/dev/null \
    || echo /usr/share/guile/site/3.0
}

_compiled_dir() {
  pkg-config --variable=siteccachedir guile-3.0 2>/dev/null \
    || echo /usr/lib/guile/3.0/site-ccache
}

build() {
  cd "$srcdir/araneola"

  # Byte-compile every module, mirroring the source tree under a staging
  # directory that package() copies into the compiled site directory.
  rm -rf "$srcdir/ccache"
  mkdir -p "$srcdir/ccache/araneola"

  while IFS= read -r scm_file; do
    rel_path="${scm_file#src/}"
    go_file="$srcdir/ccache/${rel_path%.scm}.go"
    mkdir -p "$(dirname "$go_file")"
    guild compile -L src -o "$go_file" "$scm_file"
  done < <(find src/araneola -name '*.scm')
}

check() {
  cd "$srcdir/araneola"

  guile -L src -L . tests/run-tests.scm
}

package() {
  cd "$srcdir/araneola"

  # The launcher resolves its modules and resources relative to its
  # own prefix, so the installed layout below is what it expects.
  install -Dm755 scripts/araneola "$pkgdir/usr/bin/araneola"
  sed -i 's|share/resources|share/araneola/resources|g; s|share/scripts|share/araneola/scripts|g' "$pkgdir/usr/bin/araneola"

  site_dir="$(_site_dir)"
  install -d "$pkgdir${site_dir}/araneola"
  cp -r src/araneola/. "$pkgdir${site_dir}/araneola/"

  ccache_dir="$(_compiled_dir)"
  install -d "$pkgdir${ccache_dir}/araneola"
  cp -r "$srcdir/ccache/araneola/." "$pkgdir${ccache_dir}/araneola/"

  install -d "$pkgdir/usr/share/araneola/resources"
  cp -r resources/. "$pkgdir/usr/share/araneola/resources/"
  install -Dm644 scripts/log.bash "$pkgdir/usr/share/araneola/scripts/log.bash"

  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
}
