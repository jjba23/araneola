#!/usr/bin/make -f

export DH_VERBOSE = 1

GUILE_VER = 3.0
SITE_DIR = debian/araneola/usr/share/guile/site/$(GUILE_VER)
BUILD_SITE = build/site
BUILD_CCACHE = build/ccache
# Debian's site-ccache lives in the multiarch libdir; ask Guile's
# pkg-config file instead of hard-coding a path that would be wrong
# on the next architecture.
CCACHE_DIR = $(shell pkg-config --variable=siteccachedir guile-3.0)

%:
	dh $@

# Guile's .go files are ELF objects whose debug sections dwz does
# not understand; there is no separate debug binary to compress.
override_dh_dwz:

override_dh_auto_configure:
	# Nothing to configure: Scheme sources plus (for applications) a
	# bash launcher, installed by hand below.

override_dh_auto_build:
	mkdir -p $(BUILD_SITE)/araneola $(BUILD_CCACHE)/araneola
	cp -r src/araneola/. $(BUILD_SITE)/araneola/

	# Byte-compile every module so that loading it does not compile it
	# again on first use.
	find $(BUILD_SITE)/araneola -name '*.scm' | while read -r scm_file; do \
		rel_path="$${scm_file#$(BUILD_SITE)/}"; \
		go_file="$(BUILD_CCACHE)/$${rel_path%.scm}.go"; \
		mkdir -p "$$(dirname "$$go_file")"; \
		guild compile -L $(BUILD_SITE) -o "$$go_file" "$$scm_file"; \
	done

override_dh_auto_test:
	guile -L src -L . tests/run-tests.scm

override_dh_auto_install:
	# Launcher.  It resolves its modules and resources relative to
	# its own prefix, so it is installed next to the site directory.
	install -Dm 0755 scripts/araneola debian/araneola/usr/bin/araneola
	# Upstream reads resources and the log helper from the generic
	# share/resources and share/scripts; several of these packages
	# would clash there, so both move under share/araneola/.
	sed -i 's|share/resources|share/araneola/resources|g; s|share/scripts|share/araneola/scripts|g' debian/araneola/usr/bin/araneola

	# Scheme sources and their byte-compiled copies.
	mkdir -p $(SITE_DIR) debian/araneola$(CCACHE_DIR)
	cp -r $(BUILD_SITE)/araneola $(SITE_DIR)/
	cp -r $(BUILD_CCACHE)/araneola debian/araneola$(CCACHE_DIR)/

	# Resources the launcher passes to the program: help text and,
	# depending on the project, templates, themes or migrations.
	mkdir -p debian/araneola/usr/share/araneola/resources
	cp -r resources/. debian/araneola/usr/share/araneola/resources/

	# Logging helper sourced by the launcher.
	install -Dm 0644 scripts/log.bash debian/araneola/usr/share/araneola/scripts/log.bash

override_dh_auto_clean:
	rm -rf build
	dh_auto_clean
