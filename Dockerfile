# syntax=docker/dockerfile:1.7

# araneola
#
# Generated by gen_containers.py; keep in step with packaging/.

FROM opensuse/tumbleweed:latest AS builder

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile guile-devel gcc make autoconf automake libtool \
        pkg-config gawk gnulib-devel gettext-tools findutils \
        libcurl-devel sqlite3-devel guile-json guile-gcrypt \
        guile-fibers tar gzip; \
    zypper clean --all

# Build the Guile libraries openSUSE does not package.  They are
# copied into the runtime with the project, so the image needs no
# extra repository or post-install step.

ADD https://download.savannah.gnu.org/releases/guile-lib/guile-lib-0.2.8.1.tar.gz /tmp/guile-lib.tar.gz
RUN set -eu; \
    mkdir -p "/tmp/guile-lib"; \
    tar xzf "/tmp/guile-lib.tar.gz" -C "/tmp/guile-lib" --strip-components=1; \
    cd "/tmp/guile-lib"; \
    ./configure --prefix=/usr --with-guile-site=yes; \
    make -j"$(nproc)"; \
    make install

ADD https://codeberg.org/jjba23/scriba/archive/v0.4.1.tar.gz /tmp/scriba.tar.gz
RUN set -eu; \
    mkdir -p "/tmp/scriba"; \
    tar xzf "/tmp/scriba.tar.gz" -C "/tmp/scriba" --strip-components=1; \
    install -d /usr/share/guile/site/3.0; \
    cp -r "/tmp/scriba/src/scriba" /usr/share/guile/site/3.0/

COPY src/araneola ./src/araneola
COPY scripts/araneola ./scripts/araneola
COPY resources ./resources
COPY scripts/log.bash ./scripts/log.bash

RUN set -eu; \
    site="/usr/share/guile/site/3.0"; \
    install -d "$site/araneola"; \
    cp -r "src/araneola/." "$site/araneola/"; \
    install -D -m 0755 "scripts/araneola" "/usr/bin/araneola"; \
    sed -i '1s|^#!/usr/bin/env \(.*\)$|#!/usr/bin/\1|' "/usr/bin/araneola"; \
    sed -i 's|share/resources|share/araneola/resources|g; s|share/scripts|share/araneola/scripts|g' "/usr/bin/araneola"; \
    install -d "/usr/share/araneola/resources"; \
    cp -r resources/. "/usr/share/araneola/resources/"; \
    install -D -m 0644 scripts/log.bash "/usr/share/araneola/scripts/log.bash"

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------

FROM opensuse/tumbleweed:latest AS runtime

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="araneola" \
      org.opencontainers.image.description="Web crawler and sitemap generator written in Guile Scheme" \
      org.opencontainers.image.url="https://codeberg.org/jjba23/araneola" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.version="${VERSION}"

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends \
        guile \
        ca-certificates \
        bash \
        coreutils; \
    zypper clean --all

COPY --from=builder /usr/share/guile/site /usr/share/guile/site
COPY --from=builder /usr/lib64/guile /usr/lib64/guile
RUN ldconfig
COPY --from=builder /usr/bin/araneola /usr/bin/araneola
COPY --from=builder /usr/share/araneola /usr/share/araneola

ENTRYPOINT ["/usr/bin/araneola"]
