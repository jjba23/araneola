# Commentary:
#
# This bash script provides a convenient and user-friendly wrapper
# around the command-line usage of `araneola`, allowing the
# Guile Scheme application to behave and feel like any other
# executable or binary that users may install to their systems.
#
# This also helps installing `araneola` in a convenient fashion
# to the Guix store and it allows us to decouple the user-facing
# command-line interface from the internal Guile Scheme arguments
# to the main program and library.
#
# Some of the rationale behind the `SCRIPT_DIR` and `STORE_DIR`
# can be explained due to the need of reliably and reproducibly
# deploying source code and other resources to the store
# and have access to those at runtime.

set -euo pipefail

script_dir=$(dirname "$0")
store_dir=$(readlink -f "$script_dir/..")
scheme_sources_dir="$store_dir/share/guile/site/3.0"
resources_dir="$store_dir/share/resources"
scripts_dir="$store_dir/share/scripts"

source "$scripts_dir/log.bash"

show_help() {
  cat "$resources_dir/help.txt"
}

point_to_help() {
  log_error "Try 'araneola --help' for more information."
}

#parsed_options=$(getopt -n "araneola" -o d:f:ioch --long destination:,file:,stdin,stdout,convert,help -- "$@")
#eval set -- "$parsed_options"

destination_arg=""
file_arg=""
stdin_arg=""
stdout_arg=""
convert_arg=""

guile_cmd_args=(
  "-L" "${scheme_sources_dir}"
  "-c" "((@(araneola main) main))"
  "--resources" "${resources_dir}"
)

while true; do
  case "${1}" in
  # -d | --destination)
  #   destination_arg="${2}"
  #   [[ -n "${destination_arg}" ]] && guile_cmd_args+=("--destination" "${destination_arg}")
  #   shift 2
  #   ;;
  # -i | --stdin)
  #   guile_cmd_args+=("--stdin")
  #   stdin_arg="true"
  #   shift 1
  #   ;;
  # -o | --stdout)
  #   guile_cmd_args+=("--stdout")
  #   stdout_arg="true"
  #   shift 1
  #   ;;
  # -c | --convert)
  #   guile_cmd_args+=("--convert")
  #   convert_arg="true"
  #   shift 1
  #   ;;
  # -f | --file)
  #   file_arg="${2}"
  #   guile_cmd_args+=("--file" "$(realpath "${file_arg}")")
  #   shift 2
  #   ;;
  -h | --help)
    show_help
    exit 0
    ;;
  --)
    shift
    break
    ;;
  *)
    log_error "Error: unrecognized option '${1}' !"
    point_to_help
    exit 1
    ;;
  esac
done

# if [[ (-z "${file_arg}") && (-z "${stdin_arg}") ]]; then
#   log_error "Error: Either the file or stdin options are required!" >&2
#   log_error "Use -f / --file or alternatively -i / --stdin." >&2
#   point_to_help
#   exit 1
# fi

# if [[ (-z "${stdout_arg}") && (-z "${destination_arg}") ]]; then
#   log_error "Error: Either the destination or stdout options are required!" >&2
#   log_error "Use -d / --destination or alternatively -o / --stdout." >&2
#   point_to_help
#   exit 1
# fi

# if [[ (-n "${stdout_arg}") && (-n "${convert_arg}") ]]; then
#   log_error "Error: Cannot combine stdout and convert options!" >&2
#   point_to_help
#   exit 1
# fi

# if [[ -z "${stdout_arg}" ]]; then
#   log_info "Starting Guile Glyph Generator: guile ${guile_cmd_args[*]}"
# fi

# Run Guile application
exec guile "${guile_cmd_args[@]}"
