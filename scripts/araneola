# You should have received a copy of the GNU Affero General Public License
# along with araneola. If not, see <https://www.gnu.org/licenses/>.

# Commentary:
#
# This bash script provides a convenient and user-friendly wrapper
# around the command-line usage of `araneola`, allowing the
# Guile Scheme application to behave and feel like any other
# executable or binary that users may install to their systems.
#
# This also helps installing `araneola` in a convenient fashion
# to the Guix store and it allows us to decouple the user-facing
# command-line interface from the internal Guile Scheme arguments
# to the main program and library.
#
# Some of the rationale behind the `SCRIPT_DIR` and `STORE_DIR`
# can be explained due to the need of reliably and reproducibly
# deploying source code and other resources to the store
# and have access to those at runtime.
#
# The option list is deliberately parsed once by `getopt` for the
# friendly error messages and the --help shortcut, and then handed to
# the Scheme program unchanged: validating options in two places is how
# the two definitions drift apart.

set -euo pipefail

script_dir=$(dirname "$0")
store_dir=$(readlink -f "$script_dir/..")

# Installed through Guix, the sources and resources live under share/.  Run
# straight from a checkout, they are the checkout's own src/ and resources/
# directories.  Supporting both means the script can be exercised (and
# debugged) without building a package first.
if [[ -d "$store_dir/share/guile/site/3.0" ]]; then
  scheme_sources_dir="$store_dir/share/guile/site/3.0"
  resources_dir="$store_dir/share/resources"
  scripts_dir="$store_dir/share/scripts"
else
  scheme_sources_dir="$store_dir/src"
  resources_dir="$store_dir/resources"
  scripts_dir="$store_dir/scripts"
fi

source "$scripts_dir/log.bash"

short_opts="u:o:hd:t:v"
long_opts="url:,output:,max-urls:,max-depth:,exclude:,include:,delay:,"
long_opts+="timeout:,retries:,user-agent:,sitemap-base-url:,include-subdomains,"
long_opts+="no-robots,no-split,verbose,help,resources:"

show_help() {
  cat "$resources_dir/help.txt"
}

point_to_help() {
  log_error "Try 'araneola --help' for more information."
}

if ! parsed_options=$(getopt -n "araneola" -o "$short_opts" -l "$long_opts" -- "$@"); then
  point_to_help
  exit 1
fi

# `eval set --' normalises the options, and the normalised form is what the
# Scheme program receives.
eval set -- "$parsed_options"
passthrough=("$@")

url_arg=""
while [ $# -gt 0 ]; do
  case "$1" in
    -u | --url)
      url_arg="${2:-}"
      shift 2
      ;;
    -h | --help)
      show_help
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      shift
      ;;
  esac
done

if [[ -z "${url_arg}" ]]; then
  log_error "Error: the url option is required!" >&2
  log_error "Use -u / --url" >&2
  point_to_help
  exit 1
fi

# `--' is not an option the Scheme side needs.
if [[ ${#passthrough[@]} -gt 0 && "${passthrough[-1]}" == "--" ]]; then
  unset 'passthrough[-1]'
fi

# Run the Guile application.  `main' returns the exit status rather than
# calling `exit' itself, so a partially written crawl is finalised first.
exec guile \
  -L "${scheme_sources_dir}" \
  -c '(exit ((@(araneola main) main)))' \
  --resources "${resources_dir}" \
  "${passthrough[@]}"
